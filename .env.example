# Template only — copy to .env and fill that in. NEVER put a real token here:
# .env.example is committed to a public repository, .env is gitignored.
TELEGRAM_BOT_TOKEN=
# The CHANNEL the bot posts to (@yourchannel or -100...), never the bot's own username.
TELEGRAM_CHANNEL_ID=
DATABASE_URL=sqlite:///data/market.db
APP_ENV=development
LOG_LEVEL=INFO
